{
  "opencollection": "1.0.0",
  "info": {
    "name": "Resend Apis API",
    "version": "1.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Apis",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a list of API keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.resend.com/api-keys"
          },
          "docs": "Retrieve a list of API keys"
        },
        {
          "info": {
            "name": "Create a new API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.resend.com/api-keys",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new API key"
        },
        {
          "info": {
            "name": "Remove an existing API key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.resend.com/api-keys/:api_key_id",
            "params": [
              {
                "name": "api_key_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove an existing API key"
        }
      ]
    }
  ],
  "bundled": true
}